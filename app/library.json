{
    "name": "sercom-app",
    "version": "2.0.0",
    "description": "Demo device protocol on top of sercom-core, shared by the firmware and the host tools",
    "frameworks": "*",
    "platforms": "*",
    "dependencies": {
        "sercom-core": "*"
    },
    "build": {
        "includeDir": "include",
        "srcDir": "src",
        "flags": [
            "-Wall",
            "-Wextra",
            "-Wpedantic",
            "-Wconversion",
            "-Werror",
            "-pedantic-errors",
            "-fstrict-aliasing",
            "-fvisibility=hidden",
            "-fdiagnostics-show-option",
            "-Wconversion",
            "-Wold-style-cast",
            "-Wfloat-equal",
            "-Wlogical-op",
            "-Wundef",
            "-Wredundant-decls",
            "-Wwrite-strings",
            "-Wpointer-arith",
            "-Wcast-qual",
            "-Wformat=2",
            "-Wswitch-default",
            "-Wmissing-include-dirs",
            "-Wcast-align",
            "-Wnon-virtual-dtor",
            "-Wsign-conversion",
            "-Wdisabled-optimization",
            "-Winvalid-pch",
            "-Woverloaded-virtual",
            "-Wunused-but-set-variable",
            "-Wunused-result",
            "-Wsuggest-attribute=format",
            "-Wsuggest-attribute=noreturn",
            "-Wnoexcept",
            "-Wno-missing-field-initializers",
            "-Wdouble-promotion",
            "-Wtrampolines",
            "-Wzero-as-null-pointer-constant",
            "-Wvector-operation-performance",
            "-Wshift-overflow=2",
            "-Wduplicated-cond",
            "-Walloc-zero",
            "-Walloca",
            "-Wduplicated-branches"
        ]
    }
}
